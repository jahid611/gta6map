# ─────────────────────────── Assets ───────────────────────────
# Les dossiers public/{tiles,photos,frames,wiki} sont ignorés par git : ils
# existent après `npm run setup` mais jamais sur un déploiement. Laissées vides,
# ces variables font servir l'app depuis les sources publiques d'origine
# (maps.gtadb.org, map.gtadb.org, gta.wiki) — sauf les frames de trailers, qui
# n'ont pas de source unitaire publique et doivent être hébergées.
#
# Renseignez-les avec l'URL de votre bucket après `npm run assets:upload`
# (ex. https://cdn.exemple.com/gta6/tiles).
NEXT_PUBLIC_TILES_BASE_URL=
NEXT_PUBLIC_PHOTOS_BASE_URL=
NEXT_PUBLIC_FRAMES_BASE_URL=
NEXT_PUBLIC_WIKI_IMAGES_BASE_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=

# URL publique du site (SEO, sitemap, callback auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ────────────────────────── Supabase ──────────────────────────
# Facultatif : sans ces variables, l'app lit src/data/generated/*.json et stocke
# la progression dans localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────── Upload R2 / S3 (scripts) ────────────────────
# Utilisées uniquement par `npm run assets:upload`, jamais par l'app.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
